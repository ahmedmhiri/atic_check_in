# ---- Database (Supabase Postgres) ----
# Pooled connection (used at runtime by Prisma Client). Port 6543, pgbouncer.
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Direct connection (used by prisma migrate / db push). Port 5432.
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ---- NextAuth ----
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# ---- Email ----
# Option 1 (used when SMTP_HOST is set): Gmail via SMTP, ~500 emails/day free.
#   Gmail account -> Security -> turn on 2-Step Verification -> "App passwords"
#   -> create one -> paste the 16 characters (no spaces) into SMTP_PASS.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="your.event.account@gmail.com"
SMTP_PASS="abcdefghijklmnop"
# Option 2 (used when SMTP_HOST is empty): Resend (needs a verified domain).
RESEND_API_KEY=""
# Display name for outgoing mail. With SMTP the address is always SMTP_USER.
EMAIL_FROM="Event Team <certificates@yourdomain.com>"

# ---- Seed admin (used by prisma/seed.ts) ----
SEED_ADMIN_NAME="Super Admin"
SEED_ADMIN_EMAIL="admin@yourdomain.com"
SEED_ADMIN_PASSWORD="change-me-strong-password"

# ---- Event config ----
# Certificate eligibility threshold (percent)
ELIGIBILITY_THRESHOLD="70"
# First event day (YYYY-MM-DD) and the venue's UTC offset. Used by `npm run db:seed`
# to set the real time-slot start/end times (drives PRESENT vs LATE).
EVENT_DAY1_DATE="2026-10-10"
EVENT_UTC_OFFSET="+01:00"
